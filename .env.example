DATABASE_URL="postgresql://app:app@localhost:5432/english_app"
JWT_SECRET="ganti-di-produksi"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin1234"
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
WEB_ORIGIN="http://localhost:3000"
PORT=3001
GROQ_API_KEY="ganti-di-produksi"
# Talking agent (ElevenLabs) — wajib di-set hanya kalau VOICE_AGENT_ENABLED=1
# di tabel config. API key tidak pernah dikirim ke browser (BE mint signed URL).
ELEVENLABS_API_KEY="ganti-di-produksi"
ELEVENLABS_AGENT_ID="ganti-di-produksi"
ELEVENLABS_WEBHOOK_SECRET="ganti-di-produksi"
