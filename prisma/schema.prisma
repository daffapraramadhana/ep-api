generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ContentStatus {
  DRAFT
  LIVE
  RETIRED
}

enum ItemType {
  PILIHAN_GANDA
  ISIAN
  SUSUN_KALIMAT
  UCAPAN
}

enum Level {
  DASAR
  MENENGAH
  MAHIR
}

enum Cefr {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SkillTag {
  VOCABULARY
  GRAMMAR
  LISTENING
  READING
  SPEAKING
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  AWAITING_APPROVAL
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum SessionItemSource {
  LESSON
  REVIEW
}

enum SessionKind {
  DAILY
  REPLAY
  SPEAKING
}

enum VoiceConversationStatus {
  PENDING // kredensial diminta, panggilan mungkin belum/sedang berlangsung, webhook belum datang
  GRADED // webhook sudah diproses — passed + xpAwarded final
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  role         Role    @default(USER)
  passwordHash String?
  level        Level?
  dailyTargetSessions Int @default(1)
  inviteToken  String? @unique
  inviteStatus InviteStatus @default(PENDING)
  soundOn      Boolean @default(true)
  onboardedAt  DateTime?
  voiceConsentAt DateTime? // consent rekaman suara (UU PDP) — speak menolak tanpa ini
  createdAt    DateTime @default(now())
  sessions     Session[]
  attempts     Attempt[]
  reviewQueue  ReviewQueue[]
  itemReports  ItemReport[]
  streakFreezes StreakFreeze[]
  voiceConversations VoiceConversation[]
}

model Lesson {
  id     String @id @default(cuid())
  code   String @unique
  title  String
  topic  String
  level  Level
  cefr   Cefr
  skill  SkillTag
  order  Int
  status ContentStatus @default(DRAFT)
  items  Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id              String @id @default(cuid())
  lessonId        String
  lesson          Lesson @relation(fields: [lessonId], references: [id])
  type            ItemType
  prompt          String
  options         Json?
  answerKey       String
  acceptedAnswers String[] @default([])
  explanation     String
  mediaFile       String?
  passage         String?
  order           Int
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  attempts        Attempt[]
  sessionItems    SessionItem[]
  reviewQueue     ReviewQueue[]
  itemReports     ItemReport[]
  @@unique([lessonId, order])
}

model Session {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id])
  date        DateTime @db.Date
  status      SessionStatus @default(IN_PROGRESS)
  kind        SessionKind @default(DAILY)
  xpAwarded   Int @default(0)
  completedAt DateTime?
  items       SessionItem[]
  attempts    Attempt[]
  @@index([userId, date])
}

model SessionItem {
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])
  itemId    String
  item      Item @relation(fields: [itemId], references: [id])
  source    SessionItemSource
  order     Int
  @@id([sessionId, itemId])
}

model Attempt {
  id         String  @id @default(cuid())
  userId     String
  user       User @relation(fields: [userId], references: [id])
  itemId     String
  item       Item @relation(fields: [itemId], references: [id])
  sessionId  String
  session    Session @relation(fields: [sessionId], references: [id])
  answer     String
  correct    Boolean
  firstTry   Boolean
  xpAwarded  Int @default(0)
  audioFile  String? // hanya terisi utk tipe UCAPAN — rujukan rekaman permanen
  answeredAt DateTime @default(now())
  @@index([userId, answeredAt])
}

model ReviewQueue {
  userId        String
  user          User @relation(fields: [userId], references: [id])
  itemId        String
  item          Item @relation(fields: [itemId], references: [id])
  dueDate       DateTime @db.Date
  correctStreak Int @default(0)
  @@id([userId, itemId])
}

model ItemReport {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id])
  itemId    String
  item      Item @relation(fields: [itemId], references: [id])
  note      String
  status    ReportStatus @default(OPEN)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

model Config {
  key   String @id
  value String
}

model StreakFreeze {
  userId      String
  user        User @relation(fields: [userId], references: [id])
  weekStart   DateTime @db.Date
  coveredDate DateTime @db.Date
  usedAt      DateTime @default(now())
  @@id([userId, weekStart])
}

// Percakapan suara dua arah real-time (ElevenLabs) — sesi mandiri, TIDAK
// bagian dari Session/SessionItem/Attempt (tidak ada "item" diskrit untuk
// direkam percobaannya; grading holistik dari transcript via webhook async).
model VoiceConversation {
  id                       String @id @default(cuid())
  userId                   String
  user                     User @relation(fields: [userId], references: [id])
  // ID sisi ElevenLabs — null sampai webhook datang; hanya untuk
  // ketertelusuran/dukungan, BUKAN kunci lookup utama (lookup pakai id kita
  // sendiri via dynamic_variables di webhook).
  elevenlabsConversationId String? @unique
  status                   VoiceConversationStatus @default(PENDING)
  durationSecs             Int? // data.metadata.call_duration_secs
  userTurnCount            Int? // count(transcript[].role === 'user')
  costCredits              Int? // data.metadata.cost
  // Transcript verbatim — append-only (filosofi sama dengan attempt): tidak
  // pernah dihapus, bahan mentah untuk feedback LLM (Fase C) tanpa re-fetch
  // (webhook = push sekali, tidak bisa di-replay).
  transcript               Json?
  passed                   Boolean?
  xpAwarded                Int @default(0)
  createdAt                DateTime @default(now()) // = waktu mint token
  gradedAt                 DateTime?
  @@index([userId, createdAt])
}
